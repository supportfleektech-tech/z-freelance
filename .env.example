# ---------------------------------------------------------------------------
# z-freelance environment
# Copy to `.env.local` for local development:  cp .env.example .env.local
# Every variable is optional except SESSION_SECRET in production.
# ---------------------------------------------------------------------------

NODE_ENV=development

# Public origin of the deployment. Used to build absolute links.
APP_URL=http://localhost:3000

# REQUIRED in production. Generate with:  openssl rand -base64 48
SESSION_SECRET=dev-only-insecure-session-secret-change-me
SESSION_COOKIE=zf_session
# 7 days
SESSION_TTL_SECONDS=604800

# ---------------------------------------------------------------------------
# Database
#   Set DATABASE_URL to run against a real Postgres server (production).
#   Leave it UNSET to run against embedded PGlite (Postgres-in-WASM) —
#   perfect for local development, CI and the test suite. No server needed.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zfreelance
PGLITE_DATA_DIR=.pgdata
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Platform economics
# ---------------------------------------------------------------------------
# bcrypt cost factor (tests use 4 for speed; 12 is the production default)
PASSWORD_ROUNDS=12
# Platform take rate in basis points: 1000 = 10%
PLATFORM_FEE_BPS=1000
CURRENCY=USD
# Minimum proposal bid, in cents
MIN_BID_CENTS=500
